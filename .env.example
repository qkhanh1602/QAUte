# SQL Server
DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=QAUTE;trustServerCertificate=true;encrypt=false
DB_USERNAME=qaute_app
DB_PASSWORD=change_me

# Gmail SMTP used by OTP registration
MAIL_USERNAME=qaute.edu@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Local defaults to SMTP. Render profile uses Brevo HTTPS, not blocked SMTP ports.
EMAIL_PROVIDER=smtp
EMAIL_FROM=qaute.edu@gmail.com
EMAIL_FROM_NAME=QAUTE - Ban Tu Van Sinh Vien
BREVO_API_KEY=

# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Generate: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=base64_encoded_32_byte_secret
JWT_ACCESS_MINUTES=15

# Production domain, comma separated when more than one
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

PORT=8080
SLA_HOLIDAYS=

# OTP: independent shared-network limit (each email still 3 requests/hour)
OTP_MAX_SENDS_PER_IP_HOUR=30
