# SQL Server
DB_URL=jdbc:sqlserver://127.0.0.1:1434;databaseName=QAUTE;trustServerCertificate=true;encrypt=false
DB_USERNAME=qaute_app
DB_PASSWORD=change_me

# Gmail SMTP used by OTP registration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Generate: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=base64_encoded_32_byte_secret
JWT_ACCESS_MINUTES=15

# Production domain, comma separated when more than one
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Google SSO (optional). Enable only after creating an OAuth 2.0 Web Client.
GOOGLE_SSO_ENABLED=false
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your_google_client_id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your_google_client_secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,profile,email
