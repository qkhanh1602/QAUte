<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<c:set var="sidebarPath" value="${fn:substringAfter(pageContext.request.requestURI, pageContext.request.contextPath)}" />
<div class="qaute-workspace">
<aside class="offcanvas-lg offcanvas-start qaute-navigation" tabindex="-1" id="qauteSidebar" aria-labelledby="qauteSidebarTitle">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="qauteSidebarTitle">Điều hướng QAUTE</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#qauteSidebar" aria-label="Đóng menu"></button>
    </div>
    <div class="offcanvas-body">
        <div class="sidebar-intro"><span class="sidebar-eyebrow">QAUTE / TƯ VẤN SINH VIÊN</span><h2 class="h6 mt-2 mb-1">Bạn cần hỗ trợ gì?</h2><p class="small mb-0">Chọn chức năng bên dưới để bắt đầu.</p></div>
        <nav aria-label="Menu chức năng" class="sidebar-links">
        <sec:authorize access="hasRole('SinhVien')"><div class="sidebar-group-label">Khu vực sinh viên</div>
            <a class="sidebar-link ${sidebarPath eq '/student/dashboard' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/student/dashboard" <c:if test="${sidebarPath eq '/student/dashboard'}">aria-current="page"</c:if>><i class="bi bi-grid" aria-hidden="true"></i><span><strong>Tổng quan</strong><small>Việc cần làm và thông báo</small></span></a>
            <a class="sidebar-link ${sidebarPath eq '/forum/ask' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/forum/ask" <c:if test="${sidebarPath eq '/forum/ask'}">aria-current="page"</c:if>><i class="bi bi-plus-circle" aria-hidden="true"></i><span><strong>Đặt câu hỏi</strong><small>Đặt câu hỏi cho đơn vị phụ trách</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/student/tickets') and sidebarPath ne '/forum/ask' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/student/tickets" <c:if test="${fn:startsWith(sidebarPath, '/student/tickets') and sidebarPath ne '/forum/ask'}">aria-current="page"</c:if>><i class="bi bi-chat-square-text" aria-hidden="true"></i><span><strong>Câu hỏi của tôi</strong><small>Xem phản hồi và tiến độ</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/student/appointments') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/student/appointments" <c:if test="${fn:startsWith(sidebarPath, '/student/appointments')}">aria-current="page"</c:if>><i class="bi bi-calendar-check" aria-hidden="true"></i><span><strong>Lịch hẹn tư vấn</strong><small>Đặt và theo dõi lịch hẹn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/student/chat') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/student/chat" <c:if test="${fn:startsWith(sidebarPath, '/student/chat')}">aria-current="page"</c:if>><i class="bi bi-headset" aria-hidden="true"></i><span><strong>Chat với cố vấn</strong><small>Trao đổi trực tuyến</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/student/history') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/student/history" <c:if test="${fn:startsWith(sidebarPath, '/student/history')}">aria-current="page"</c:if>><i class="bi bi-clock-history" aria-hidden="true"></i><span><strong>Lịch sử tư vấn</strong><small>Tra cứu các lần tư vấn</small></span></a>
        </sec:authorize>
        <sec:authorize access="hasRole('CoVan')"><div class="sidebar-group-label">Khu vực cố vấn</div>
            <a class="sidebar-link ${sidebarPath eq '/advisor/dashboard' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/advisor/dashboard" <c:if test="${sidebarPath eq '/advisor/dashboard'}">aria-current="page"</c:if>><i class="bi bi-grid" aria-hidden="true"></i><span><strong>Tổng quan</strong><small>Công việc và lịch tư vấn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/advisor/tickets') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/advisor/tickets" <c:if test="${fn:startsWith(sidebarPath, '/advisor/tickets')}">aria-current="page"</c:if>><i class="bi bi-inbox" aria-hidden="true"></i><span><strong>Câu hỏi cần xử lý</strong><small>Tiếp nhận và trả lời sinh viên</small></span></a>
            <c:if test="${!isStudentAdvisor}">
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/advisor/appointments') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/advisor/appointments" <c:if test="${fn:startsWith(sidebarPath, '/advisor/appointments')}">aria-current="page"</c:if>><i class="bi bi-calendar-check" aria-hidden="true"></i><span><strong>Lịch hẹn sinh viên</strong><small>Duyệt và theo dõi lịch hẹn</small></span></a>
            </c:if>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/advisor/chat') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/advisor/chat" <c:if test="${fn:startsWith(sidebarPath, '/advisor/chat')}">aria-current="page"</c:if>><i class="bi bi-headset" aria-hidden="true"></i><span><strong>Chat với sinh viên</strong><small>Tiếp nhận trao đổi trực tuyến</small></span></a>
        </sec:authorize>
        <sec:authorize access="hasRole('Admin')"><div class="sidebar-group-label">Khu vực quản trị</div>
            <a class="sidebar-link ${sidebarPath eq '/admin/dashboard' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/dashboard" <c:if test="${sidebarPath eq '/admin/dashboard'}">aria-current="page"</c:if>><i class="bi bi-bar-chart" aria-hidden="true"></i><span><strong>Tổng quan & báo cáo</strong><small>Thống kê hoạt động tư vấn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/tickets') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/tickets" <c:if test="${fn:startsWith(sidebarPath, '/admin/tickets')}">aria-current="page"</c:if>><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Điều phối tư vấn</strong><small>Phân công và theo dõi câu hỏi</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/users') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/users" <c:if test="${fn:startsWith(sidebarPath, '/admin/users')}">aria-current="page"</c:if>><i class="bi bi-people" aria-hidden="true"></i><span><strong>Quản lý tài khoản</strong><small>Sinh viên và cố vấn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/catalogs') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/catalogs" <c:if test="${fn:startsWith(sidebarPath, '/admin/catalogs')}">aria-current="page"</c:if>><i class="bi bi-collection" aria-hidden="true"></i><span><strong>Đơn vị & lĩnh vực</strong><small>Danh mục khoa và tư vấn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/content') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/content" <c:if test="${fn:startsWith(sidebarPath, '/admin/content')}">aria-current="page"</c:if>><i class="bi bi-journal-text" aria-hidden="true"></i><span><strong>Bài viết & hỏi đáp</strong><small>Quản lý nội dung hướng dẫn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/email-queue') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/email-queue"><i class="bi bi-envelope-exclamation" aria-hidden="true"></i><span><strong>Email cần xử lý</strong><small>Thông báo chưa gửi thành công</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/admin/search') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/search" <c:if test="${fn:startsWith(sidebarPath, '/admin/search')}">aria-current="page"</c:if>><i class="bi bi-search" aria-hidden="true"></i><span><strong>Tra cứu hệ thống</strong><small>Tìm câu hỏi, lịch hẹn và nhật ký</small></span></a>
        </sec:authorize>
        <div class="sidebar-group-label">Khám phá & hướng dẫn</div>
            <a class="sidebar-link ${sidebarPath eq '/' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/" <c:if test="${sidebarPath eq '/'}">aria-current="page"</c:if>><i class="bi bi-house-door" aria-hidden="true"></i><span><strong>Trang chủ</strong><small>Giới thiệu cổng tư vấn</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/forum') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/forum"><i class="bi bi-chat-square-text" aria-hidden="true"></i><span><strong>Diễn đàn tư vấn</strong><small>Câu hỏi và trả lời công khai</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/faq') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/faq" <c:if test="${fn:startsWith(sidebarPath, '/faq')}">aria-current="page"</c:if>><i class="bi bi-question-circle" aria-hidden="true"></i><span><strong>Hỏi đáp thường gặp</strong><small>Tìm câu trả lời đã có</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/articles') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/articles" <c:if test="${fn:startsWith(sidebarPath, '/articles')}">aria-current="page"</c:if>><i class="bi bi-journal" aria-hidden="true"></i><span><strong>Bài viết hướng dẫn</strong><small>Quy trình và thông tin hữu ích</small></span></a>
            <a class="sidebar-link ${fn:startsWith(sidebarPath, '/advisors') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/advisors" <c:if test="${fn:startsWith(sidebarPath, '/advisors')}">aria-current="page"</c:if>><i class="bi bi-person-badge" aria-hidden="true"></i><span><strong>Danh sách cố vấn</strong><small>Tìm cố vấn theo khoa</small></span></a>
        <sec:authorize access="isAuthenticated()">
            <a class="sidebar-link ${sidebarPath eq '/profile' ? 'is-active' : ''}" href="${pageContext.request.contextPath}/profile" <c:if test="${sidebarPath eq '/profile'}">aria-current="page"</c:if>><i class="bi bi-person-circle" aria-hidden="true"></i><span><strong>Hồ sơ cá nhân</strong><small>Ảnh đại diện và thông tin của bạn</small></span></a>
        </sec:authorize>
        </nav>
        <sec:authorize access="!isAuthenticated()"><div class="sidebar-help"><strong>Sinh viên mới?</strong><p class="small">Đăng nhập để gửi câu hỏi, đặt lịch và theo dõi câu trả lời.</p><a class="btn btn-primary w-100" href="${pageContext.request.contextPath}/login">Đăng nhập để bắt đầu</a></div></sec:authorize>
        <div class="sidebar-support"><i class="bi bi-envelope" aria-hidden="true"></i> qaute.edu@gmail.com</div>
    </div>
</aside>
<div class="qaute-workspace-content">
