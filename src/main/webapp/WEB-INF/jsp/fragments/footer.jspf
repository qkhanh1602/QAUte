<%@ page pageEncoding="UTF-8" %>
<footer class="mt-auto text-white pt-4 pb-3" style="background-color:#0b2b59!important;border-top:3px solid #dc2626">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-4">
                <a class="d-inline-flex align-items-center gap-2 text-white text-decoration-none mb-2" href="${pageContext.request.contextPath}/">
                    <span class="d-grid bg-white rounded-3" style="width:38px;height:38px;color:#123b76;place-items:center"><i class="bi bi-mortarboard-fill fs-5"></i></span>
                    <span class="fs-5 fw-bold">QAUTE</span>
                </a>
                <p class="small text-white-50 mb-0">Nền tảng hỏi đáp và tư vấn dành cho sinh viên.</p>
            </div>
            <div class="col-lg-5">
                <nav class="d-flex flex-wrap gap-3 justify-content-lg-center small" aria-label="Điều hướng cuối trang">
                    <a class="text-white text-decoration-none" href="${pageContext.request.contextPath}/">Trang chủ</a>
                    <a class="text-white-50 text-decoration-none" href="${pageContext.request.contextPath}/faq">Hỏi đáp</a>
                    <a class="text-white-50 text-decoration-none" href="${pageContext.request.contextPath}/articles">Bài viết</a>
                    <a class="text-white-50 text-decoration-none" href="${pageContext.request.contextPath}/advisors">Cố vấn</a>
                    <a class="text-white-50 text-decoration-none" href="${pageContext.request.contextPath}/profile">Hồ sơ</a>
                </nav>
            </div>
            <div class="col-lg-3 text-lg-end small text-white-50">
                <div><i class="bi bi-envelope me-1"></i> qaute.edu@gmail.com</div>
                <div class="mt-1">Hỗ trợ từ thứ 2 đến thứ 6</div>
            </div>
        </div>
        <hr class="my-3 opacity-25">
        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 small text-white-50">
            <span>© 2026 QAUTE.</span>
            <span>Hệ thống tư vấn sinh viên</span>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</footer>

</div><!-- qaute-workspace-content -->
</div><!-- qaute-workspace -->
