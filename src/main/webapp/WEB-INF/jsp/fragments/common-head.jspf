<%@ page pageEncoding="UTF-8" %>
<meta name="qaute-content-view" content="jsp-jstl">
<title><c:out value="${pageTitle}" /> - Hệ thống Tư vấn Sinh viên QAUTE</title>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Google Fonts -->

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">


<!-- Bootstrap 5.3.3 & Bootstrap Icons (Primary CDN + Fallback CDN) -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">


<style>
        :root {
            /* === BẢNG MÀU CHUẨN MỚI QAUTE === */
            --qaute-navbar: #0b2b59;           /* Navbar chính: Xanh navy (30, 58, 95) */
            --qaute-navbar-rgb: 30, 58, 95;
            --qaute-navbar-hover: #123b76;     /* Navbar hover: Navy sáng (41, 78, 120) */
            --qaute-primary: #123b76;          /* Màu chủ đạo / nút chính: Xanh dương (18, 59, 118) */
            --qaute-primary-rgb: 18, 59, 118;
            --qaute-primary-hover: #0c2d5b;    /* Hover nút chính: Xanh đậm (29, 78, 216) */
            --qaute-secondary: #123b76;        /* Màu phụ: Xanh teal (18, 59, 118) */
            --qaute-secondary-rgb: 18, 59, 118;
            --qaute-teal-light: #dc2626;       /* Teal sáng: (220, 38, 38) */
            --qaute-teal-light-rgb: 220, 38, 38;
            --qaute-bg: #F8FAFC;               /* Background toàn trang: Xám trắng (248, 250, 252) */
            --qaute-bg-section: #F1F5F9;       /* Background section: (241, 245, 249) */
            --qaute-card-bg: #FFFFFF;          /* Card: Trắng (255, 255, 255) */
            --qaute-border: #E2E8F0;           /* Border: Xám nhạt (226, 232, 240) */
            --qaute-heading: #0F172A;          /* Chữ tiêu đề: (15, 23, 42) */
            --qaute-text: #334155;             /* Chữ thường: (51, 65, 85) */
            --qaute-muted: #64748B;            /* Chữ phụ: (100, 116, 139) */
            --qaute-success: #194984;          /* Thành công: (25, 73, 132) */
            --qaute-success-rgb: 25, 73, 132;
            --qaute-warning: #b91c1c;          /* Cảnh báo: (185, 28, 28) */
            --qaute-warning-rgb: 185, 28, 28;
            --qaute-danger: #DC2626;           /* Lỗi: (220, 38, 38) */
            --qaute-danger-rgb: 220, 38, 38;

            /* Backward compatibility alias */
            --qaute-sidebar: var(--qaute-navbar);

            /* Bootstrap 5.3 Overrides */
            --bs-primary: #123b76;
            --bs-primary-rgb: 18, 59, 118;
            --bs-secondary: #123b76;
            --bs-secondary-rgb: 18, 59, 118;
            --bs-info: #dc2626;
            --bs-info-rgb: 220, 38, 38;
            --bs-success: #194984;
            --bs-success-rgb: 25, 73, 132;
            --bs-warning: #b91c1c;
            --bs-warning-rgb: 185, 28, 28;
            --bs-danger: #DC2626;
            --bs-danger-rgb: 220, 38, 38;
            --bs-light: #F1F5F9;
            --bs-light-rgb: 241, 245, 249;
            --bs-tertiary-bg: #F1F5F9;
            --bs-body-bg: #F8FAFC;
            --bs-body-color: #334155;
            --bs-secondary-color: #64748B;
            --bs-heading-color: #0F172A;
            --bs-border-color: #E2E8F0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--qaute-bg) !important;
            color: var(--qaute-text) !important;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* === TYPOGRAPHY === */
        h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            color: var(--qaute-heading) !important;
            font-weight: 700;
        }

        .text-dark {
            color: var(--qaute-heading) !important;
        }

        .text-body {
            color: var(--qaute-text) !important;
        }

        .text-secondary {
            color: var(--qaute-muted) !important;
        }

        .text-muted {
            color: var(--qaute-muted) !important;
        }

        .text-primary {
            color: var(--qaute-primary) !important;
        }

        .text-success {
            color: var(--qaute-success) !important;
        }

        .text-warning {
            color: var(--qaute-warning) !important;
        }

        .text-danger {
            color: var(--qaute-danger) !important;
        }

        /* === NAVBAR CHÍNH === */
        .navbar-qaute {
            background-color: var(--qaute-navbar) !important;
            background-image: none !important;
            box-shadow: 0 4px 20px -2px rgba(30, 58, 95, 0.35);
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .navbar-brand-qaute {
            font-weight: 800;
            font-size: 1.35rem;
            letter-spacing: -0.5px;
            color: #FFFFFF !important;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-badge {
            background-color: var(--qaute-teal-light); /* #dc2626 */
            color: #FFFFFF;
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-link-qaute {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link-qaute:hover {
            color: #FFFFFF !important;
            background-color: var(--qaute-navbar-hover) !important; /* #123b76 Navbar hover */
        }

        .nav-link-qaute.active {
            color: #FFFFFF !important;
            background-color: var(--qaute-primary) !important; /* #123b76 */
            font-weight: 600;
        }

        .navbar-qaute .dropdown-toggle:hover {
            background-color: var(--qaute-navbar-hover) !important;
        }

        /* === BACKGROUND SECTION & CARD === */
        .qaute-section-bg, .bg-section {
            background-color: var(--qaute-bg-section) !important; /* #F1F5F9 */
        }

        .bg-light {
            background-color: var(--qaute-bg-section) !important; /* #F1F5F9 */
        }

        .qaute-card, .card {
            background-color: var(--qaute-card-bg) !important; /* #FFFFFF */
            border: 1px solid var(--qaute-border) !important;  /* #E2E8F0 */
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04), 0 2px 4px -2px rgba(15, 23, 42, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .qaute-card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px -4px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1 !important;
        }

        .border, .border-top, .border-bottom, .border-start, .border-end {
            border-color: var(--qaute-border) !important;
        }

        /* === BUTTONS === */
        .btn-qaute-primary, .btn-primary {
            background: linear-gradient(135deg, var(--qaute-primary) 0%, #3b82f6 100%) !important;
            background-color: var(--qaute-primary) !important; /* #123b76 */
            border-color: var(--qaute-primary) !important;
            color: #FFFFFF !important;
            font-weight: 600;
            padding: 0.6rem 1.3rem;
            border-radius: 0.6rem;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(18, 59, 118, 0.25);
        }

        .btn-qaute-primary:hover, .btn-qaute-primary:focus,
        .btn-primary:hover, .btn-primary:focus {
            background: linear-gradient(135deg, var(--qaute-primary-hover) 0%, var(--qaute-primary) 100%) !important;
            background-color: var(--qaute-primary-hover) !important; /* #0c2d5b */
            border-color: var(--qaute-primary-hover) !important;
            color: #FFFFFF !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(18, 59, 118, 0.35);
        }

        .btn-qaute-outline, .btn-outline-primary {
            border: 1.5px solid var(--qaute-primary) !important;
            color: var(--qaute-primary) !important;
            font-weight: 600;
            padding: 0.55rem 1.2rem;
            border-radius: 0.6rem;
            background: transparent !important;
            transition: all 0.2s ease;
        }

        .btn-qaute-outline:hover, .btn-outline-primary:hover {
            background-color: var(--qaute-primary) !important;
            border-color: var(--qaute-primary) !important;
            color: #FFFFFF !important;
            box-shadow: 0 4px 12px rgba(18, 59, 118, 0.25);
        }

        .btn-qaute-accent {
            background-color: var(--qaute-teal-light) !important; /* #dc2626 */
            border: none !important;
            color: #FFFFFF !important;
            font-weight: 700;
            padding: 0.55rem 1.2rem;
            border-radius: 50rem;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.25);
        }

        .btn-qaute-accent:hover {
            background-color: var(--qaute-secondary) !important; /* #123b76 */
            color: #FFFFFF !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(18, 59, 118, 0.35);
        }

        .btn-success {
            background-color: var(--qaute-success) !important; /* #194984 */
            border-color: var(--qaute-success) !important;
            color: #FFFFFF !important;
        }
        .btn-success:hover {
            background-color: #194984 !important;
            border-color: #194984 !important;
            color: #FFFFFF !important;
        }

        .btn-outline-success {
            border-color: var(--qaute-success) !important;
            color: var(--qaute-success) !important;
        }
        .btn-outline-success:hover {
            background-color: var(--qaute-success) !important;
            color: #FFFFFF !important;
        }

        .btn-warning {
            background-color: var(--qaute-warning) !important; /* #b91c1c */
            border-color: var(--qaute-warning) !important;
            color: #FFFFFF !important;
        }
        .btn-warning:hover {
            background-color: #991b1b !important;
            border-color: #991b1b !important;
            color: #FFFFFF !important;
        }

        .btn-outline-warning {
            border-color: var(--qaute-warning) !important;
            color: var(--qaute-warning) !important;
        }
        .btn-outline-warning:hover {
            background-color: var(--qaute-warning) !important;
            color: #FFFFFF !important;
        }

        .btn-danger {
            background-color: var(--qaute-danger) !important; /* #DC2626 */
            border-color: var(--qaute-danger) !important;
            color: #FFFFFF !important;
        }
        .btn-danger:hover {
            background-color: #b91c1c !important;
            border-color: #b91c1c !important;
            color: #FFFFFF !important;
        }

        .btn-outline-danger {
            border-color: var(--qaute-danger) !important;
            color: var(--qaute-danger) !important;
        }
        .btn-outline-danger:hover {
            background-color: var(--qaute-danger) !important;
            color: #FFFFFF !important;
        }

        .btn-secondary {
            background-color: var(--qaute-secondary) !important; /* #123b76 */
            border-color: var(--qaute-secondary) !important;
            color: #FFFFFF !important;
        }
        .btn-secondary:hover {
            background-color: #0c2d5b !important;
            border-color: #0c2d5b !important;
            color: #FFFFFF !important;
        }

        .btn-info {
            background-color: var(--qaute-teal-light) !important; /* #dc2626 */
            border-color: var(--qaute-teal-light) !important;
            color: #FFFFFF !important;
        }
        .btn-info:hover {
            background-color: var(--qaute-secondary) !important; /* #123b76 */
            border-color: var(--qaute-secondary) !important;
            color: #FFFFFF !important;
        }

        .btn-outline-info {
            border-color: var(--qaute-teal-light) !important;
            color: var(--qaute-secondary) !important;
        }
        .btn-outline-info:hover {
            background-color: var(--qaute-teal-light) !important;
            color: #FFFFFF !important;
        }

        /* === SUBNAV & SIDEBAR STYLES === */
        .qaute-subnav {
            background-color: var(--qaute-card-bg);
            border: 1px solid var(--qaute-border);
            border-radius: 50rem;
            padding: 0.35rem 0.5rem;
            box-shadow: 0 2px 4px rgba(15, 23, 42, 0.03);
        }

        .qaute-sidebar-card {
            background-color: var(--qaute-card-bg);
            border: 1px solid var(--qaute-border);
            border-radius: 1rem;
            overflow: hidden;
        }

        .qaute-sidebar-header {
            background-color: var(--qaute-navbar);
            color: #FFFFFF;
            padding: 0.85rem 1.2rem;
            font-weight: 700;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* === STATUS BADGES === */
        .status-badge {
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            border-radius: 50rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .status-ChoTiepNhan, .status-ChoDuyet {
            background-color: #fee2e2;
            color: var(--qaute-warning); /* #b91c1c */
            border: 1px solid #fecaca;
        }

        .status-DangXuLy {
            background-color: #edf2fa;
            color: var(--qaute-secondary); /* #123b76 */
            border: 1px solid #c7d4e7;
        }

        .status-DaPhanHoi, .status-DaXacNhan, .status-HoanThanh {
            background-color: #edf2fa;
            color: var(--qaute-success); /* #194984 */
            border: 1px solid #bfcee5;
        }

        .status-TuChoi, .status-Huy {
            background-color: #FEE2E2;
            color: var(--qaute-danger); /* #DC2626 */
            border: 1px solid #FECACA;
        }

        .status-Dong {
            background-color: var(--qaute-bg-section); /* #F1F5F9 */
            color: var(--qaute-muted); /* #64748B */
            border: 1px solid var(--qaute-border); /* #E2E8F0 */
        }

        /* === ALERTS === */
        .alert-success {
            background-color: #edf2fa !important;
            color: #123b76 !important;
            border-color: #c7d4e7 !important;
        }
        .alert-warning {
            background-color: #fff1f2 !important;
            color: #991b1b !important;
            border-color: #fecaca !important;
        }
        .alert-danger {
            background-color: #FEF2F2 !important;
            color: #991B1B !important;
            border-color: #FECACA !important;
        }
        .alert-info {
            background-color: #edf2fa !important;
            color: #0c2d5b !important;
            border-color: #c7d4e7 !important;
        }

        /* === BOOTSTRAP SUBTLE BADGES & BACKGROUNDS === */
        .bg-primary-subtle {
            background-color: #EFF6FF !important;
            color: var(--qaute-primary) !important;
        }
        .bg-secondary-subtle {
            background-color: #edf2fa !important;
            color: var(--qaute-secondary) !important;
        }
        .bg-success-subtle {
            background-color: #edf2fa !important;
            color: var(--qaute-success) !important;
        }
        .bg-warning-subtle {
            background-color: #fff1f2 !important;
            color: var(--qaute-warning) !important;
        }
        .bg-danger-subtle {
            background-color: #FEF2F2 !important;
            color: var(--qaute-danger) !important;
        }
        .bg-info-subtle {
            background-color: #edf2fa !important;
            color: var(--qaute-teal-light) !important;
        }

        /* === HERO BANNER === */
        .hero-banner {
            background: linear-gradient(135deg, #0b2b59 0%, #0c2d5b 55%, #123b76 100%);
            color: #FFFFFF;
            padding: 4.5rem 0 3.5rem 0;
            border-radius: 0 0 2.5rem 2.5rem;
            margin-bottom: 2.5rem;
            box-shadow: 0 10px 30px -10px rgba(30, 58, 95, 0.3);
        }

        /* === CHAT BUBBLES === */
        .chat-bubble-sender {
            background: linear-gradient(135deg, var(--qaute-primary) 0%, var(--qaute-primary-hover) 100%);
            color: #FFFFFF;
            border-radius: 1.2rem 1.2rem 0.2rem 1.2rem;
            padding: 0.8rem 1.1rem;
            max-width: 75%;
            margin-left: auto;
            box-shadow: 0 2px 6px rgba(18, 59, 118, 0.2);
        }

        .chat-bubble-receiver {
            background-color: var(--qaute-card-bg); /* #FFFFFF */
            color: var(--qaute-text); /* #334155 */
            border: 1px solid var(--qaute-border); /* #E2E8F0 */
            border-radius: 1.2rem 1.2rem 1.2rem 0.2rem;
            padding: 0.8rem 1.1rem;
            max-width: 75%;
            box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04);
        }

        .rating-stars {
            color: var(--qaute-warning); /* #b91c1c */
            font-size: 1.2rem;
        }

        /* === FORM CONTROLS FOCUS === */
        .form-control, .form-select {
            color: var(--qaute-text);
            background-color: var(--qaute-card-bg);
            border: 1px solid var(--qaute-border);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--qaute-primary);
            box-shadow: 0 0 0 0.2rem rgba(18, 59, 118, 0.15);
            color: var(--qaute-heading);
        }
    </style>

<link href="${pageContext.request.contextPath}/css/qaute-theme.css?v=20261003-blue-red-2" rel="stylesheet">
